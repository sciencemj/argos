{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Argos",
  "version": "0.1.2",
  "identifier": "app.argos.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Argos",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 8,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "일정, 할 일, 노트, 에이전트를 한곳에서",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/argos-server"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4ODE2MzE1REU3RUE3MQpSV1J4NnVkZE1SYUlDcW1lM2VYOENqQWo0N2pvN3daZlJKalI2cEliY1VMMGVDMy9oTDhIbnA0OQo=",
      "endpoints": [
        "https://github.com/sciencemj/argos/releases/latest/download/latest.json"
      ]
    }
  }
}
