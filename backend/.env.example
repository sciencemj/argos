# Copy to .env and adjust. All keys use the ARGOS_ prefix.
ARGOS_HOST=127.0.0.1
# 8000 is the desktop app's port; `make dev` runs this backend on 8100 instead.
ARGOS_PORT=8000
# Everything Argos writes; relative paths (db, backups, …) are inside this folder.
ARGOS_DATA_DIR=data
ARGOS_DB_PATH=argos.db
# ARGOS_VAULT_PATH=/path/to/obsidian/vault
ARGOS_SEED_PATH=seed.example.toml
ARGOS_TIMEZONE=Asia/Seoul
ARGOS_DUE_SOON_DAYS=3
ARGOS_WIP_LIMIT=3

# Inbox classifier. Leave ARGOS_CLASSIFIER_MODEL empty to keep text unclassified in the inbox.
ARGOS_CLASSIFIER_PROVIDER=ollama
ARGOS_CLASSIFIER_MODEL=
# ARGOS_CLASSIFIER_BASE_URL=http://127.0.0.1:11434/v1
# ARGOS_CLASSIFIER_API_KEY=   (hermes)
# ARGOS_CLASSIFIER_REASONING_EFFORT=none   (default: none for ollama, not sent for hermes)
ARGOS_CLASSIFIER_THRESHOLD=0.85
# Types applied automatically at/above the threshold, e.g. ["task"]
ARGOS_CLASSIFIER_AUTO_APPLY=[]

# Agents. The default agent can also be picked in the app's settings screen.
ARGOS_DEFAULT_AGENT=hermes
ARGOS_HERMES_BASE_URL=http://127.0.0.1:8642/v1
# ARGOS_HERMES_API_KEY=   (API_SERVER_KEY in ~/.hermes/.env, see docs/hermes-setup.md)
ARGOS_HERMES_MODEL=hermes-agent
# ARGOS_CLAUDE_BIN=claude
# ARGOS_CODEX_BIN=codex
# Codex: "app-server" (streaming, persistent threads; experimental protocol) or "exec"
ARGOS_CODEX_MODE=app-server
# ARGOS_CODEX_HOME=codex-home   (only auth.json is linked from ~/.codex)

# Coding jobs (PLAN Phase 6). Jobs may only write inside these directories; a job
# without --dir gets a new folder in the first one. The settings screen overrides this.
ARGOS_JOB_ROOTS=["jobs"]
ARGOS_JOB_CONCURRENCY=1
# ARGOS_JOB_TIMEOUT=1800        (seconds)
# ARGOS_JOB_MAX_BUDGET_USD=2.0  (Claude only)

# Address other devices use to reach Argos (Tailscale serve URL). Used for links such as
# the calendar feed; without it the app uses the address the browser opened.
# ARGOS_PUBLIC_URL=https://<machine>.<tailnet>.ts.net

# iCloud calendars (PLAN 7b). Connect with the Apple ID and an app-specific password in
# the settings screen; the password is kept in the macOS Keychain, never in this file.
# ARGOS_CALDAV_URL=https://caldav.icloud.com/
# ARGOS_CALDAV_WRITE_CALENDAR=Argos   (the only calendar Argos writes to)
# ARGOS_CALDAV_POLL_MINUTES=10        (0 turns the timer off; "지금 동기화" still works)

# Obsidian vault (PLAN Phase 8). Usually picked in the settings screen, which also lists
# the vaults the Obsidian app knows. The daily notes folder defaults to the vault's own
# Daily Notes / Periodic Notes setting.
# ARGOS_VAULT_PATH=/path/to/vault
# ARGOS_VAULT_DAILY_FOLDER=Daily
# ARGOS_VAULT_DAILY_DAYS=14            (older daily notes are not searched for tasks)
# ARGOS_VAULT_BACKUP_DIR=vault-backups

# Plan usage in the status bar (PLAN Phase 9). Claude's comes from its usage endpoint
# with the login Claude Code saved (macOS Keychain, else ARGOS_CLAUDE_DIR/.credentials.json);
# Codex is asked through its app-server.
# ARGOS_CLAUDE_DIR=~/.claude
# ARGOS_USAGE_POLL_MINUTES=5   (0 turns the timer off)

# Debates (PLAN Phase 10): the whole debate must end within this many seconds.
# ARGOS_DEBATE_BUDGET_SECONDS=900

# Notices, weekly review, backups (PLAN Phase 11). Most are also in the settings screen.
# ARGOS_NOTIFY_INTERVAL_MINUTES=15      (0 turns the checks off)
# ARGOS_NOTIFY_DIGEST_HOUR=9            (daily roundups after this local hour)
# ARGOS_NOTIFY_HERMES_TARGET=discord    (messenger delivery through `hermes send`; off when empty)
# ARGOS_WEEKLY_REVIEW_WEEKDAY=6         (Monday 0 … Sunday 6)
# ARGOS_WEEKLY_REVIEW_HOUR=20
# ARGOS_REVIEW_EMBED_MODEL=             (Ollama embedding model; empty: the first installed *embed* model)
# ARGOS_BACKUP_KEEP=14
# ARGOS_BACKUP_DIR=backups
